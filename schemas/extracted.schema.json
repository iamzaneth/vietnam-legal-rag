  "not": {
    "required": [
      "document",
      "content"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "hierarchy_validation",
          "form_validation",
          "structured_paragraph_audit"
        ]
      }
    },
    {
      "if": {
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "validation"
        ],
        "properties": {
          "validation": {
            "required": [
              "unparsed_source"
            ],
            "properties": {
              "unparsed_source": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "const": "extracted"
          },
          "status": {
            "enum": [
              "success",
              "success_with_warnings"
            ]
          }
        }
      },
      "then": {
        "required": [
          "quality",
          "files",
          "source_files",
          "tabs",
          "diagnostic_info_count",
          "warning_count",
          "error_count",
          "fatal_count"
        ]
      }
    }
  ]
